int32 id # 指令ID

float64[6] desc # 机械臂末端姿态, 笛卡尔坐标:0-2对应tran坐标的xyz,3-5对应rpy位姿的rx,ry,rz

# YOLO模型初始化
string model_path # ONNX模型路径
int32 input_height # 模型输入高度
int32 input_width # 模型输入宽度

# YOLO检测参数
float64 confidence_threshold # 置信度阈值
float64 nms_threshold # 非极大值抑制阈值

---

int32 err_code # 错误码

string msg

YoloResult[] results # YOLO检测结果
SphereLoc sphere_loc # 球体在相机坐标系中的位置,单位m
