int32 id # 指令ID

string station          # 站点
string[] station_list   # 站点列表

float32 manual_x         # 手动控制 x方向线速度 vx (机器人坐标系，单位 m/s)
float32 manual_y         # 手动控制 y方向线速度 vy (机器人坐标系，单位 m/s)
float32 manual_w         # 手动控制 角速度 w (单位 rad/s，逆时针为正，顺时针为负)
int32 manual_duration      # 手动控制持续时间  (单位 ms, 0 持续执行直到下条指令 | >0 持续指定时间后停止 | <0 视作忽略该参数)

---

int32 err_code # 错误码
string msg

int32 task_status     # 导航状态 0 = NONE, 1 = WAITING(目前不可能出现该状态), 2 = RUNNING, 3 = SUSPENDED, 4 = COMPLETED, 5 = FAILED, 6 = CANCELED
int32 task_type       # 导航类型 0 = 没有导航, 1 = 自由导航到任意点, 2 = 自由导航到站点, 3 = 路径导航到站点, 7 = 平动转动, 100 = 其他
string target_station # 导航目标站点

AgvStation current_station
AgvStation[] station_list